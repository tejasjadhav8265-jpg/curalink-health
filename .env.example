# Copy this file to a new file named ".env" (same folder) and fill in the values.
# Never share your real .env file or put it on GitHub.

# Where MongoDB is. For MongoDB on your own computer:
MONGO_URI=mongodb://127.0.0.1:27017/curalink
# For MongoDB Atlas, paste the connection string from Atlas instead.

# A long random sentence used to sign login cookies. Change it. At least 32 characters.
JWT_SECRET=change-this-to-a-long-random-sentence-of-your-own
JWT_EXPIRES_IN=1d

PORT=5000
NODE_ENV=development
# The address people open in the browser (used for cookies and CORS).
CLIENT_ORIGIN=http://localhost:5000

# Biggest report upload, in megabytes.
UPLOAD_MAX_MB=5

# The first admin account, created by:  npm run seed:admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe@12345

# Optional: passwords used by the demo seed (defaults shown).
# SEED_DOCTOR_PASSWORD=Doctor@12345
# SEED_PATIENT_PASSWORD=Patient@12345

# Only when hosted behind a proxy (Render, Railway...): 1
# TRUST_PROXY=1
